# Copy to .env (never commit .env) and load it before starting the backend, e.g.:
#   set -a; source .env; set +a; cd backend && mvn spring-boot:run

# --- Database (MySQL 8) ---
# Homebrew MySQL on this machine listens on 3307; the MySQL default is 3306.
# Quoted because of the '&'s: without quotes `source .env` stops at the first one.
DB_URL='jdbc:mysql://localhost:3307/pacific_marketplace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
DB_USERNAME=pacific
DB_PASSWORD=change-me-please

# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Card payments (optional; without any of these the shop is pay-on-delivery only) ---
# Where the storefront is served from. Stripe sends customers back here after paying.
PUBLIC_URL=http://localhost:5173
# Real card payments through Stripe Checkout. Use a TEST key (sk_test_...) until you are ready to go live.
# STRIPE_SECRET_KEY=
# From the webhook endpoint in the Stripe dashboard (or `stripe listen`). Without it the webhook is disabled, and
# payments are only confirmed when the customer returns to the site.
# STRIPE_WEBHOOK_SECRET=
# Local development only: a fake, clearly labelled payment page that moves no money. NEVER set this in production
# (the app refuses to start with a live Stripe key and the simulator together).
# PAYMENTS_SIMULATOR_ENABLED=true

# --- Product photos uploaded by sellers and admins (default: backend/uploads). Use a disk that survives redeploys. ---
# UPLOADS_DIR=/var/lib/pacific/uploads

# --- Development only: fill the shop with ~150 invented products, stores, shoppers and reviews ---
# DEMO_DATA=true

# --- First admin on a fresh install (only used if no admin exists yet) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- One-off import of the old JavaFX app's data (only into an EMPTY database) ---
# LEGACY_SQLITE_PATH=backend/legacy-import/DataBase1.db
