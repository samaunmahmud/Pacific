# Copy to .env (never commit .env) and load it before starting the backend, e.g.:
#   set -a; source .env; set +a; cd backend && mvn spring-boot:run

# --- Database (MySQL 8) ---
# Homebrew MySQL on this machine listens on 3307; the MySQL default is 3306.
DB_URL=jdbc:mysql://localhost:3307/pacific_marketplace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=pacific
DB_PASSWORD=change-me-please

# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- First admin on a fresh install (only used if no admin exists yet) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- One-off import of the old JavaFX app's data (only into an EMPTY database) ---
# LEGACY_SQLITE_PATH=backend/legacy-import/DataBase1.db
